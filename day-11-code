model2=SVC(kernel='linear')
model3=SVC(kernel='poly',degree=3)
model1.fit(x_train,y_train)
model2.fit(x_train,y_train)
model3.fit(x_train,y_train)
    y_pred1=model1.predict(x_test)
y_pred1
    y_pred2=model2.predict(x_test)
y_pred2
    y_pred3=model3.predict(x_test)
y_pred3
    sample=[]
for feature in iris.feature_names:
    value=float(input(f"Enter the value of {feature}:"))
    sample.append(value)
sample=scaler.transform([sample])
prediction=model1.predict(sample)
print("predicted_class ",iris.target_names[prediction[0]])
    accuracy=accuracy_score(y_test,y_pred)
accuracy
    cm=confusion_matrix(y_test,y_pred)
print(cm)
    report=classification_report(y_test,y_test)
print(report)
    results={
    "rbf":accuracy_score(y_test,y_pred1),
    "linear":accuracy_score(y_test,y_pred2),
    "poly":accuracy_score(y_test,y_pred3)
    
}
plt.bar(results.keys(),results.values())
color=['blue','red','green']
