import pandas as pd
from sklearn.preprocessing import LabelEncoder
from sklearn.model_selection import train_test_split
from sklearn.ensemble import AdaBoostClassifier
from sklearn.metrics import accuracy_score
confusion_matrix,classification_report
import matplotlib.pyplot as plt
  data=pd.read_csv("Downloads/Titanic-Dataset.csv")
data.head()
  data['Age'].fillna(data['Age'].median(),inplace=True)
  data['Embarked'].fillna(data['Embarked'].mode()[0],inplace=True)
  data.drop(['Cabin','Ticket','Name'],axis=1,inplace=True)
  Encoder=LabelEncoder()
data['Sex']=Encoder.fit_transform(data['Sex'])
  data=pd.get_dummies(data,columns=['Embarked'],dtype=int)
data.head()
  x=data.drop("Survived",axis=1)
y=data["Survived"]
  x_train,x_test,y_train,y_test=train_test_split(x,y,test_size=0.2,random_state=100)
    model=AdaBoostClassifier(n_estimators=100,learning_rate=1,random_state=100)
model.fit(x_train,y_train)
AdaBoostClassifier(learning_rate=1,n_estimators=100,random_state=100)
    y_pred=model.predict(x_test)
y_pred
    accuracy=accuracy_score(y_test,y_pred)
accuracy
    cm=confusion_matrix(y_test,y_pred)
cm
    report=classification_report(y_test,y_pred)
print(report)
